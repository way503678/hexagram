# 複製這個檔案成 .env 並填入真實值
# cp .env.example .env

# 管理員名單:這些 email 用一般帳號註冊/登入後即擁有最高權限
# 多個用逗號分隔,例:a@x.com,b@y.com
ADMIN_EMAILS=you@example.com

# Flask session 簽章金鑰
# 產生方法:openssl rand -hex 32
SECRET_KEY=please-generate-with-openssl-rand-hex-32

# 寄信(忘記密碼用)。未設定時重設連結只會寫進 log,不會真的寄出。
# 任何 SMTP 供應商都可:Gmail / SendGrid / Resend / Mailgun…
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=命卦排盤 <you@gmail.com>
# 重設連結要用的對外網址(信中連結的網域),不設則用請求網址
# PUBLIC_BASE_URL=https://hexagram.johnsonwebsites.cc
